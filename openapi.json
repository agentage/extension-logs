                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "extension": {
                            "type": "string"
                          },
                          "part": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "method": {
                            "type": "string"
                          },
