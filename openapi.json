{
  "openapi": "3.1.0",
  "info": {
    "title": "logs",
    "version": "0.4.0"
  },
  "components": {
    "securitySchemes": {
      "pat": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "agcid": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "details": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["field", "message"],
                      "additionalProperties": false
                    }
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                ]
              }
            },
            "required": ["code", "message", "agcid"],
            "additionalProperties": false
          }
        },
        "required": ["success", "error"],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/v1/events": {
      "post": {
        "summary": "Ingest events",
        "security": [
          {
            "pat": ["logs:write"]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "maxItems": 1000,
                "type": "array",
                "items": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accepted": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "rejected": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["accepted", "rejected"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Events, newest first (order=asc for a trace): kind, filters, cursor",
        "security": [
          {
            "pat": ["logs:admin"]
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["info", "warn", "error"]
            }
          },
          {
            "name": "extension",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          {
            "name": "part",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          {
            "name": "host",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][\\w.-]{0,252}$"
            }
          },
          {
            "name": "agcid",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          {
            "name": "sub",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          {
            "name": "ok",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": ["true", "false"]
                }
              ]
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["http", "mcp", "job", "span", "error", "event", "log", "host", "container"]
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "default": "desc",
              "type": "string",
              "enum": ["desc", "asc"]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "default": "ts",
              "type": "string",
              "enum": ["ts", "ms"]
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "default": "24h",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{1,4}[mhd]$"
                },
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              ]
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{1,4}[mhd]$"
                },
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "level": {
                            "type": "string",
                            "enum": ["info", "warn", "error"]
                          },
                          "kind": {
                            "type": "string",
                            "enum": ["http", "mcp", "job", "span", "error", "event", "log"]
                          },
                          "msg": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "extension": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "part": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "version": {
                            "default": "",
                            "type": "string",
                            "maxLength": 64
                          },
                          "host": {
                            "type": "string",
                            "maxLength": 253
                          },
                          "agcid": {
                            "default": null,
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[0-9a-f]{32}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "sub": {
                            "default": null,
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 128
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "session": {
                            "default": null,
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 128
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "fields": {
                            "default": {},
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          },
                          "id": {
                            "type": "string"
                          },
                          "ts": {
                            "type": "string"
                          },
                          "userType": {
                            "type": "string"
                          },
                          "client": {
                            "type": "string"
                          },
                          "method": {
                            "type": "string"
                          },
                          "route": {
                            "type": "string"
                          },
                          "status": {
                            "type": "number"
                          },
                          "ms": {
                            "type": "number"
                          },
                          "ok": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "level",
                          "kind",
                          "msg",
                          "extension",
                          "part",
                          "version",
                          "agcid",
                          "sub",
                          "session",
                          "fields",
                          "id",
                          "ts",
                          "userType",
                          "client",
                          "method",
                          "route",
                          "status",
                          "ms",
                          "ok"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/traces/{agcid}": {
