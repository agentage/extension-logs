            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "agcid": {
                          "type": "string"
                        },
                        "hops": {
                          "type": "number"
                        },
                        "ms": {
                          "type": "number"
                        },
                        "ok": {
                          "type": "boolean"
                        },
                        "events": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "level": {
                                "type": "string",
                                "enum": ["info", "warn", "error"]
                              },
                              "kind": {
                                "type": "string",
                                "enum": ["http", "mcp", "job", "span", "error", "event", "log"]
                              },
                              "msg": {
                                "type": "string",
                                "maxLength": 2000
                              },
                              "extension": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64
                              },
                              "part": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64
                              },
                              "version": {
                                "default": "",
                                "type": "string",
                                "maxLength": 64
                              },
                              "host": {
                                "type": "string",
                                "maxLength": 253
                              },
                              "agcid": {
                                "default": null,
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{32}$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "sub": {
                                "default": null,
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 128
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "session": {
                                "default": null,
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 128
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "fields": {
                                "default": {},
                                "type": "object",
                                "propertyNames": {
                                  "type": "string"
                                },
                                "additionalProperties": {}
                              },
                              "id": {
                                "type": "string"
                              },
                              "ts": {
                                "type": "string"
                              },
                              "userType": {
                                "type": "string"
                              },
                              "client": {
                                "type": "string"
                              },
                              "method": {
                                "type": "string"
                              },
                              "route": {
                                "type": "string"
                              },
                              "status": {
                                "type": "number"
                              },
                              "ms": {
                                "type": "number"
                              },
                              "ok": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "level",
                              "kind",
                              "msg",
                              "extension",
                              "part",
                              "version",
                              "agcid",
                              "sub",
                              "session",
                              "fields",
                              "id",
                              "ts",
                              "userType",
                              "client",
                              "method",
