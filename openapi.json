            "schema": {
              "default": "1h",
              "type": "string",
              "enum": ["15m", "1h", "24h"]
            }
          },
          {
            "name": "extension",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
