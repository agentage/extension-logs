    {
      "description": "Log rows, newest first; order \"asc\" reads oldest first (one request in time order).\nFilters: kind (http, mcp, job, span, error, log, event, host, container), level, extension, part,\nhost, route, status, sub, agcid, q (text in msg, or an agcid), since and until (15m, 2h, 7d or ISO).\nlimit pages; nextCursor goes back as cursor. Examples:\n- errors that mention a timeout, last 2 hours: {\"level\":\"error\",\"q\":\"timeout\",\"since\":\"2h\"}\n- one request, every hop in time order: {\"agcid\":\"<32 hex>\",\"order\":\"asc\",\"since\":\"30d\"}\n- the 500 answers of one route: {\"kind\":\"http\",\"route\":\"/api/v1/machines\",\"status\":500}\n- the tool calls of one caller: {\"kind\":\"mcp\",\"sub\":\"usr_7f3a\"}\nFor counts, failure rates, latency or machines over time use logs__aggregate.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "agcid": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          },
          "cursor": {
            "maxLength": 200,
            "type": "string"
          },
          "extension": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "host": {
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][\\w.-]{0,252}$",
            "type": "string"
          },
          "kind": {
            "enum": ["http", "mcp", "job", "span", "error", "event", "log", "host", "container"],
            "type": "string"
          },
          "level": {
            "enum": ["info", "warn", "error"],
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "order": {
            "default": "desc",
            "enum": ["desc", "asc"],
            "type": "string"
          },
          "part": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "q": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "route": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "since": {
            "anyOf": [
              {
                "pattern": "^\\d{1,4}[mhd]$",
                "type": "string"
              },
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              }
            ],
            "default": "24h"
          },
          "status": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "sub": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "until": {
            "anyOf": [
              {
                "pattern": "^\\d{1,4}[mhd]$",
                "type": "string"
              },
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              }
            ]
          }
        },
        "type": "object"
      },
      "name": "logs__query",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "additionalProperties": false,
