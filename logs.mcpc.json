                },
                "ok": {
                  "type": "boolean"
                },
                "part": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "route": {
                  "type": "string"
                },
                "session": {
                  "anyOf": [
                    {
                      "maxLength": 128,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "status": {
                  "type": "number"
                },
                "sub": {
                  "anyOf": [
                    {
                      "maxLength": 128,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
