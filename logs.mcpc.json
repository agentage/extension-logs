{
  "serverInfo": {
    "name": "agentage-logs",
    "version": "0.3.0"
  },
  "tools": [
    {
      "description": "Search logged events, newest first: text in msg or an agcid, level, extension, kind, since (15m, 2h, 7d).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "extension": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": ["http", "mcp", "job", "span", "error", "event", "log", "host", "container"],
            "type": "string"
          },
          "level": {
            "enum": ["info", "warn", "error"],
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "q": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "since": {
            "anyOf": [
              {
                "pattern": "^\\d{1,4}[mhd]$",
                "type": "string"
              },
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              }
            ],
            "default": "24h"
          }
        },
        "type": "object"
      },
      "name": "logs__search",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "agcid": {
                  "anyOf": [
                    {
                      "pattern": "^[0-9a-f]{32}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "client": {
                  "type": "string"
                },
                "extension": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "fields": {
                  "additionalProperties": {},
                  "default": {},
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "host": {
                  "maxLength": 253,
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": ["http", "mcp", "job", "span", "error", "event", "log"],
                  "type": "string"
                },
                "level": {
                  "enum": ["info", "warn", "error"],
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "ms": {
                  "type": "number"
                },
                "msg": {
                  "maxLength": 2000,
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                },
                "part": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "route": {
                  "type": "string"
                },
                "session": {
                  "anyOf": [
                    {
                      "maxLength": 128,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "status": {
                  "type": "number"
                },
                "sub": {
                  "anyOf": [
                    {
                      "maxLength": 128,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "ts": {
                  "type": "string"
                },
                "userType": {
                  "type": "string"
                },
                "version": {
                  "default": "",
                  "maxLength": 64,
                  "type": "string"
                }
              },
              "required": [
                "level",
                "kind",
                "msg",
                "extension",
                "part",
                "version",
                "agcid",
                "sub",
                "session",
                "fields",
                "id",
                "ts",
                "userType",
                "client",
                "method",
                "route",
                "status",
                "ms",
                "ok"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
