{
  "serverInfo": {
    "name": "agentage-logs",
    "version": "0.2.1"
  },
  "tools": [
    {
      "description": "Search logged events, newest first: text in msg or an agcid, level, extension, kind, since (15m, 2h, 7d).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "extension": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": ["http", "mcp", "job", "span", "error", "event", "log"],
            "type": "string"
          },
          "level": {
            "enum": ["info", "warn", "error"],
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "q": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "since": {
            "anyOf": [
              {
                "pattern": "^\\d{1,4}[mhd]$",
                "type": "string"
              },
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              }
            ],
            "default": "24h"
          }
        },
        "type": "object"
      },
      "name": "logs__search",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "agcid": {
                  "anyOf": [
                    {
                      "pattern": "^[0-9a-f]{32}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "client": {
                  "type": "string"
                },
                "extension": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "fields": {
                  "additionalProperties": {},
                  "default": {},
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "host": {
                  "maxLength": 253,
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": ["http", "mcp", "job", "span", "error", "event", "log"],
                  "type": "string"
                },
                "level": {
                  "enum": ["info", "warn", "error"],
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "ms": {
                  "type": "number"
                },
                "msg": {
                  "maxLength": 2000,
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                },
                "part": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "route": {
                  "type": "string"
                },
                "session": {
                  "anyOf": [
                    {
                      "maxLength": 128,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "status": {
                  "type": "number"
                },
                "sub": {
                  "anyOf": [
                    {
                      "maxLength": 128,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "ts": {
                  "type": "string"
                },
                "userType": {
                  "type": "string"
                },
                "version": {
                  "default": "",
                  "maxLength": 64,
                  "type": "string"
                }
              },
              "required": [
                "level",
                "kind",
                "msg",
                "extension",
                "part",
                "version",
                "agcid",
                "sub",
                "session",
                "fields",
                "id",
                "ts",
                "userType",
                "client",
                "method",
                "route",
                "status",
                "ms",
                "ok"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "description": "Every event of one agcid (32 hex) in time order, with hops, ms and ok.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "agcid": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": ["agcid"],
        "type": "object"
      },
      "name": "logs__trace",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "agcid": {
            "type": "string"
          },
          "events": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "agcid": {
                  "anyOf": [
                    {
                      "pattern": "^[0-9a-f]{32}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "client": {
                  "type": "string"
                },
                "extension": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "fields": {
                  "additionalProperties": {},
                  "default": {},
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "host": {
                  "maxLength": 253,
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": ["http", "mcp", "job", "span", "error", "event", "log"],
                  "type": "string"
                },
                "level": {
                  "enum": ["info", "warn", "error"],
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "ms": {
                  "type": "number"
                },
                "msg": {
                  "maxLength": 2000,
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                },
                "part": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "route": {
                  "type": "string"
                },
                "session": {
                  "anyOf": [
                    {
                      "maxLength": 128,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "status": {
                  "type": "number"
                },
                "sub": {
                  "anyOf": [
                    {
                      "maxLength": 128,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "ts": {
                  "type": "string"
                },
                "userType": {
                  "type": "string"
                },
                "version": {
                  "default": "",
                  "maxLength": 64,
                  "type": "string"
                }
              },
              "required": [
                "level",
                "kind",
                "msg",
                "extension",
                "part",
                "version",
                "agcid",
                "sub",
                "session",
                "fields",
                "id",
                "ts",
                "userType",
                "client",
                "method",
                "route",
                "status",
                "ms",
                "ok"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "hops": {
            "type": "number"
          },
          "ms": {
            "type": "number"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": ["agcid", "hops", "ms", "ok", "events"],
        "type": "object"
      }
    },
    {
      "description": "Errors grouped by exception type and message: count, last seen, one agcid.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "extension": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "since": {
            "anyOf": [
              {
                "pattern": "^\\d{1,4}[mhd]$",
                "type": "string"
              },
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              }
            ],
            "default": "24h"
          }
        },
        "type": "object"
      },
      "name": "logs__errors",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "errors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "agcid": {
                  "type": ["string", "null"]
                },
                "count": {
                  "type": "number"
                },
                "lastSeen": {
                  "type": "string"
                },
                "msg": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": ["type", "msg", "count", "lastSeen", "agcid"],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "description": "Per extension, part, route and tool: calls, errors, availability, p50, p95, p99, users.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "extension": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "window": {
            "default": "1h",
            "enum": ["15m", "1h", "24h"],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "logs__stats",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "stats": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "availability": {
                  "type": ["number", "null"]
                },
                "calls": {
                  "type": "number"
                },
                "errors": {
                  "type": "number"
                },
                "extension": {
                  "type": "string"
                },
                "failed": {
                  "type": "number"
                },
                "kind": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "p50": {
                  "type": "number"
                },
                "p95": {
                  "type": "number"
                },
                "p99": {
                  "type": "number"
                },
                "part": {
                  "type": "string"
                },
                "requests": {
                  "type": "number"
                },
                "route": {
                  "type": "string"
                },
                "users": {
                  "type": "number"
                }
              },
              "required": [
                "extension",
                "part",
                "kind",
                "method",
                "route",
                "calls",
                "errors",
                "failed",
                "requests",
                "users",
                "availability",
                "p50",
                "p95",
                "p99"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "description": "The last sample per host (cpu, mem, disk, load1, containers, red), or one host's containers.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "host": {
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][\\w.-]{0,252}$",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "logs__hosts",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "containers": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": ["number", "null"]
                },
                "limit": {
                  "type": ["number", "null"]
                },
                "mem": {
                  "type": ["number", "null"]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": ["name", "cpu", "mem", "limit"],
              "type": "object"
            },
            "type": "array"
          },
          "hosts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "at": {
                  "type": "string"
                },
                "containers": {
                  "type": ["number", "null"]
                },
                "cpu": {
                  "type": ["number", "null"]
                },
                "cpu1h": {
                  "type": ["number", "null"]
                },
                "disk": {
                  "type": ["number", "null"]
                },
                "host": {
                  "type": "string"
                },
                "load1": {
                  "type": ["number", "null"]
                },
                "mem": {
                  "type": ["number", "null"]
                },
                "red": {
                  "type": "boolean"
                }
              },
              "required": [
                "host",
                "cpu",
                "cpu1h",
                "mem",
                "disk",
                "load1",
                "containers",
                "at",
                "red"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  ]
}
